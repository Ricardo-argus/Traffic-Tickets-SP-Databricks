# Copy this file to .env and adjust. .env is gitignored; this template stays versioned.

# Absolute path of the pipeline's src/ folder
MULTAS_SRC=/Workspace/Users/<your-user>/Traffic-Tickets-SP-Databricks/src

# Optional overrides (defaults: multas_analytics; the repo's data/ folder)
# MULTAS_CATALOG=multas_analytics
# MULTAS_DATA_DIR=/Workspace/Users/<your-user>/Traffic-Tickets-SP-Databricks/data